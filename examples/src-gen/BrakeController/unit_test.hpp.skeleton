#ifndef BRAKECONTROLLERUNITTEST_HPP
#define BRAKECONTROLLERUNITTEST_HPP

#include "runnable.hpp"

#include <atomic>
#include <csignal>
#include <cstdint>
#include <memory>

#include <system_error>
#include <cstdint>
#include <score/log/LoggerConsoleSink.hpp>
#include <score/middleware/Port.hpp>
#include <score/middleware/TaskBase.hpp>
#include <score/middleware/Util.hpp>

#include <gtest/gtest.h>

class BrakeControllerTest : public ::testing::Test {
  protected:
    void SetUp() override;
    void TearDown() override;
    void SetInputData();
    void SetParameters();
    void SetExpectedOutputData();
    void InitInputBuffers();
    void InitOutputBuffers();
    void ValidateOutputData();
    void OnInit();
    void OnUpdate();
    void OnReset();

  private:
    static constexpr std::string_view kLogPrefix{"BrakeControllerTest"};

    using brake_commands_mutable_buffer_type = score::comm::ShmMutableSampleBuffer<adas::perception::BrakeCommand, 2>;
    using brake_commands_vector_element_type = std::pair<score::comm::SampleReference::slot_type, brake_commands_mutable_buffer_type::mutable_sample_type>;

    // Inputs
    adas::perception::ObjectDetections test_object_detections_{};

    BrakeControllerParameters parameters_{};

    BrakeController runnable_{};
    score::comm::ShmSampleBufferManager<> buffer_manager_{};
    BrakeControllerInternalState internal_state_{};

    // Input buffers
    std::unique_ptr<BrakeControllerInputs> input_buffers_{};
    std::vector<const adas::perception::ObjectDetections*> object_detections_received_(1);

    // Output buffers
    std::unique_ptr<BrakeControllerOutputs> output_buffers_{};

    // adas::perception::BrakeCommand containers
    std::vector<brake_commands_vector_element_type> brake_commands_vector(1);
    brake_commands_mutable_buffer_type brake_commands_buffer_{0};
    // Expected data
    std::vector<adas::perception::BrakeCommand> brake_commands_vector_expected(1);

    score::log::LoggerConsoleSink console_logger_output_{score::log::LogLevel::kDebug3};
};

#endif  // BRAKECONTROLLERUNITTEST_HPP
