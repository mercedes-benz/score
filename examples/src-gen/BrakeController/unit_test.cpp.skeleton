void BrakeControllerTest::ValidateOutputData() {
    ASSERT_EQ(brake_commands_vector_expected.size(), brake_commands_vector.size());
    for (size_t idx = 0; idx < brake_commands_vector.size(); idx++) {
        brake_commands_vector_element_type& pair_output = *brake_commands_vector[idx];
        score::comm::SampleBufferEntry<adas::perception::BrakeCommand, score::comm::kDefaultPageSize>& output_buff = *pair_output.second;
        const adas::perception::BrakeCommand& runnable_result = output_buff.sample.get();
        const adas::perception::BrakeCommand& expected_result = *brake_commands_vector_expected[idx];
        ASSERT_TRUE( std::memcmp( &runnable_result, &expected_result, sizeof(adas::perception::BrakeCommand) ) == 0 );
    }
}

void BrakeControllerTest::InitInputBuffers() {
    std::error result{std::errorCode::kSuccess};
    // adas::perception::ObjectDetections
    score::comm::TopicName input_topic_name_object_detections = score::comm::TopicName::fromStrings("test", "test", "test", "object_detections_in").value_or({});
    result = buffer_manager_.initialize<adas::perception::ObjectDetections, 4>(input_topic_name_object_detections);
    if (!result.success()) {
        score::log::fatal("BrakeControllerTest", "Failed to initialize buffer manager");
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);

    object_detections_received_.push_back(&test_object_detections_);
    input_buffers_.reset( new BrakeControllerInputs{
      std::queue{ object_detections_received_ },
    });
}

void BrakeControllerTest::InitOutputBuffers() {
    std::error result{std::errorCode::kSuccess};
    ///////////////////////////////////////////////////////
    // brake_commands containers for the output processing for-loops
    score::comm::TopicId brake_commands_topic_id_{};
    // Trying to emulate what Fabric does for the SHM buffer
    score::comm::TopicName output_topic_name_brake_commands =
        score::comm::TopicName::fromStrings("test", "test", "test", "BrakeCommand_out").value_or({});

    // Initialize brake_commands output buffers
    result = buffer_manager_.initialize<adas::perception::BrakeCommand, 2>(output_topic_name_brake_commands);
    if (!result.success()) {
        score::log::fatal(kLogPrefix, "Failed to initialize buffer manager for output");
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    result = brake_commands_buffer_.open(output_topic_name_brake_commands.fullName());
    if (!result.success()) {
        score::log::fatal(kLogPrefix, "Failed to open ShmBuffer: ", result);
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    result = brake_commands_buffer_.reclaim();
    if (!result.success()) {
        score::log::warn(kLogPrefix, "Failed to reclaim samples..", result);
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    output_buffers_.reset( new BrakeControllerOutputs {
        std::queue<brake_commands_mutable_buffer_type::base_type, 1>  {
            brake_commands_buffer_,
            brake_commands_vector
        },
    });
}

