#ifndef SYSTEMLOGGERUNITTEST_HPP
#define SYSTEMLOGGERUNITTEST_HPP

#include "runnable.hpp"

#include <atomic>
#include <csignal>
#include <cstdint>
#include <memory>

#include <system_error>
#include <cstdint>
#include <score/log/LoggerConsoleSink.hpp>
#include <score/middleware/Port.hpp>
#include <score/middleware/TaskBase.hpp>
#include <score/middleware/Util.hpp>

#include <gtest/gtest.h>

class SystemLoggerTest : public ::testing::Test {
  protected:
    void SetUp() override;
    void TearDown() override;
    void SetInputData();
    void SetParameters();
    void SetExpectedOutputData();
    void InitInputBuffers();
    void InitOutputBuffers();
    void ValidateOutputData();
    void OnInit();
    void OnUpdate();
    void OnReset();

  private:
    static constexpr std::string_view kLogPrefix{"SystemLoggerTest"};

    using log_entries_mutable_buffer_type = score::comm::ShmMutableSampleBuffer<adas::perception::LogEntry, 2>;
    using log_entries_vector_element_type = std::pair<score::comm::SampleReference::slot_type, log_entries_mutable_buffer_type::mutable_sample_type>;

    // Inputs
    adas::perception::CameraFrame test_camera_data_log_{};
    adas::perception::ObjectDetections test_detection_log_{};
    adas::perception::BrakeCommand test_brake_command_log_{};
    adas::perception::TrafficSignCommand test_traffic_sign_log_{};

    SystemLoggerParameters parameters_{};

    SystemLogger runnable_{};
    score::comm::ShmSampleBufferManager<> buffer_manager_{};
    SystemLoggerInternalState internal_state_{};

    // Input buffers
    std::unique_ptr<SystemLoggerInputs> input_buffers_{};
    std::vector<const adas::perception::CameraFrame*> camera_data_log_received_(1);
    std::vector<const adas::perception::ObjectDetections*> detection_log_received_(1);
    std::vector<const adas::perception::BrakeCommand*> brake_command_log_received_(1);
    std::vector<const adas::perception::TrafficSignCommand*> traffic_sign_log_received_(1);

    // Output buffers
    std::unique_ptr<SystemLoggerOutputs> output_buffers_{};

    // adas::perception::LogEntry containers
    std::vector<log_entries_vector_element_type> log_entries_vector(10);
    log_entries_mutable_buffer_type log_entries_buffer_{0};
    // Expected data
    std::vector<adas::perception::LogEntry> log_entries_vector_expected(10);

    score::log::LoggerConsoleSink console_logger_output_{score::log::LogLevel::kDebug3};
};

#endif  // SYSTEMLOGGERUNITTEST_HPP
