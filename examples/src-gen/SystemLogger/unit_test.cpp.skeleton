void SystemLoggerTest::InitOutputBuffers() {
    std::error result{std::errorCode::kSuccess};
    ///////////////////////////////////////////////////////
    // log_entries containers for the output processing for-loops
    score::comm::TopicId log_entries_topic_id_{};
    // Trying to emulate what Fabric does for the SHM buffer
    score::comm::TopicName output_topic_name_log_entries =
        score::comm::TopicName::fromStrings("test", "test", "test", "LogEntry_out").value_or({});

    // Initialize log_entries output buffers
    result = buffer_manager_.initialize<adas::perception::LogEntry, 2>(output_topic_name_log_entries);
    if (!result.success()) {
        score::log::fatal(kLogPrefix, "Failed to initialize buffer manager for output");
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    result = log_entries_buffer_.open(output_topic_name_log_entries.fullName());
    if (!result.success()) {
        score::log::fatal(kLogPrefix, "Failed to open ShmBuffer: ", result);
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    result = log_entries_buffer_.reclaim();
    if (!result.success()) {
        score::log::warn(kLogPrefix, "Failed to reclaim samples..", result);
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    output_buffers_.reset( new SystemLoggerOutputs {
        std::queue<log_entries_mutable_buffer_type::base_type, 10>  {
            log_entries_buffer_,
            log_entries_vector
        },
    });
}

