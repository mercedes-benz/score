void SystemLoggerTest::ValidateOutputData() {
    ASSERT_EQ(log_entries_vector_expected.size(), log_entries_vector.size());
    for (size_t idx = 0; idx < log_entries_vector.size(); idx++) {
        log_entries_vector_element_type& pair_output = *log_entries_vector[idx];
        score::comm::SampleBufferEntry<adas::perception::LogEntry, score::comm::kDefaultPageSize>& output_buff = *pair_output.second;
        const adas::perception::LogEntry& runnable_result = output_buff.sample.get();
        const adas::perception::LogEntry& expected_result = *log_entries_vector_expected[idx];
        ASSERT_TRUE( std::memcmp( &runnable_result, &expected_result, sizeof(adas::perception::LogEntry) ) == 0 );
    }
}

