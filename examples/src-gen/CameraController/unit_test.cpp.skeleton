void CameraControllerTest::ValidateOutputData() {
    ASSERT_EQ(camera_frames_vector_expected.size(), camera_frames_vector.size());
    for (size_t idx = 0; idx < camera_frames_vector.size(); idx++) {
        camera_frames_vector_element_type& pair_output = *camera_frames_vector[idx];
        score::comm::SampleBufferEntry<adas::perception::CameraFrame, score::comm::kDefaultPageSize>& output_buff = *pair_output.second;
        const adas::perception::CameraFrame& runnable_result = output_buff.sample.get();
        const adas::perception::CameraFrame& expected_result = *camera_frames_vector_expected[idx];
        ASSERT_TRUE( std::memcmp( &runnable_result, &expected_result, sizeof(adas::perception::CameraFrame) ) == 0 );
    }
}

