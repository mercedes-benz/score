    score::log::info(kLogPrefix, "runnable_.onUpdate() execution time was: ", finish_time.time_since_epoch().count() - time.time_since_epoch().count(), " nanoseconds");
    ASSERT_EQ(result, std::error{std::errorCode::kSuccess});
}

