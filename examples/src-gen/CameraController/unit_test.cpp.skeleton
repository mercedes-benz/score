void CameraControllerTest::InitOutputBuffers() {
    std::error result{std::errorCode::kSuccess};
    ///////////////////////////////////////////////////////
    // camera_frames containers for the output processing for-loops
    score::comm::TopicId camera_frames_topic_id_{};
    // Trying to emulate what Fabric does for the SHM buffer
    score::comm::TopicName output_topic_name_camera_frames =
        score::comm::TopicName::fromStrings("test", "test", "test", "CameraFrame_out").value_or({});

    // Initialize camera_frames output buffers
    result = buffer_manager_.initialize<adas::perception::CameraFrame, 2>(output_topic_name_camera_frames);
    if (!result.success()) {
        score::log::fatal(kLogPrefix, "Failed to initialize buffer manager for output");
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    result = camera_frames_buffer_.open(output_topic_name_camera_frames.fullName());
    if (!result.success()) {
        score::log::fatal(kLogPrefix, "Failed to open ShmBuffer: ", result);
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    result = camera_frames_buffer_.reclaim();
    if (!result.success()) {
        score::log::warn(kLogPrefix, "Failed to reclaim samples..", result);
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    output_buffers_.reset( new CameraControllerOutputs {
        std::queue<camera_frames_mutable_buffer_type::base_type, 1>  {
            camera_frames_buffer_,
            camera_frames_vector
        },
    });
}

