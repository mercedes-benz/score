#ifndef CAMERACONTROLLERUNITTEST_HPP
#define CAMERACONTROLLERUNITTEST_HPP

#include "runnable.hpp"

#include <atomic>
#include <csignal>
#include <cstdint>
#include <memory>

#include <system_error>
#include <cstdint>
#include <score/log/LoggerConsoleSink.hpp>
#include <score/middleware/Port.hpp>
#include <score/middleware/TaskBase.hpp>
#include <score/middleware/Util.hpp>

#include <gtest/gtest.h>

class CameraControllerTest : public ::testing::Test {
  protected:
    void SetUp() override;
    void TearDown() override;
    void SetInputData();
    void SetParameters();
    void SetExpectedOutputData();
    void InitInputBuffers();
    void InitOutputBuffers();
    void ValidateOutputData();
    void OnInit();
    void OnUpdate();
    void OnReset();

  private:
    static constexpr std::string_view kLogPrefix{"CameraControllerTest"};

    using camera_frames_mutable_buffer_type = score::comm::ShmMutableSampleBuffer<adas::perception::CameraFrame, 3>;
    using camera_frames_vector_element_type = std::pair<score::comm::SampleReference::slot_type, camera_frames_mutable_buffer_type::mutable_sample_type>;

    // Inputs

    CameraControllerParameters parameters_{};

    CameraController runnable_{};
    score::comm::ShmSampleBufferManager<> buffer_manager_{};
    CameraControllerInternalState internal_state_{};

    // Input buffers
    std::unique_ptr<CameraControllerInputs> input_buffers_{};

    // Output buffers
    std::unique_ptr<CameraControllerOutputs> output_buffers_{};

    // adas::perception::CameraFrame containers
    std::vector<camera_frames_vector_element_type> camera_frames_vector(1);
    camera_frames_mutable_buffer_type camera_frames_buffer_{0};
    // Expected data
    std::vector<adas::perception::CameraFrame> camera_frames_vector_expected(1);

    score::log::LoggerConsoleSink console_logger_output_{score::log::LogLevel::kDebug3};
};

#endif  // CAMERACONTROLLERUNITTEST_HPP
