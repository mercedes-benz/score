#ifndef PERFORMANCETRACERUNITTEST_HPP
#define PERFORMANCETRACERUNITTEST_HPP

#include "runnable.hpp"

#include <atomic>
#include <csignal>
#include <cstdint>
#include <memory>

#include <system_error>
#include <cstdint>
#include <score/log/LoggerConsoleSink.hpp>
#include <score/middleware/Port.hpp>
#include <score/middleware/TaskBase.hpp>
#include <score/middleware/Util.hpp>

#include <gtest/gtest.h>

class PerformanceTracerTest : public ::testing::Test {
  protected:
    void SetUp() override;
    void TearDown() override;
    void SetInputData();
    void SetParameters();
    void SetExpectedOutputData();
    void InitInputBuffers();
    void InitOutputBuffers();
    void ValidateOutputData();
    void OnInit();
    void OnUpdate();
    void OnReset();

  private:
    static constexpr std::string_view kLogPrefix{"PerformanceTracerTest"};

    using performance_traces_mutable_buffer_type = score::comm::ShmMutableSampleBuffer<adas::perception::PerformanceTrace, 2>;
    using performance_traces_vector_element_type = std::pair<score::comm::SampleReference::slot_type, performance_traces_mutable_buffer_type::mutable_sample_type>;

    // Inputs
    adas::perception::CameraFrame test_camera_perf_trace_{};
    adas::perception::ObjectDetections test_neural_net_perf_trace_{};
    adas::perception::BrakeCommand test_brake_perf_trace_{};
    adas::perception::TrafficSignCommand test_traffic_sign_perf_trace_{};

    PerformanceTracerParameters parameters_{};

    PerformanceTracer runnable_{};
    score::comm::ShmSampleBufferManager<> buffer_manager_{};
    PerformanceTracerInternalState internal_state_{};

    // Input buffers
    std::unique_ptr<PerformanceTracerInputs> input_buffers_{};
    std::vector<const adas::perception::CameraFrame*> camera_perf_trace_received_(1);
    std::vector<const adas::perception::ObjectDetections*> neural_net_perf_trace_received_(1);
    std::vector<const adas::perception::BrakeCommand*> brake_perf_trace_received_(1);
    std::vector<const adas::perception::TrafficSignCommand*> traffic_sign_perf_trace_received_(1);

    // Output buffers
    std::unique_ptr<PerformanceTracerOutputs> output_buffers_{};

    // adas::perception::PerformanceTrace containers
    std::vector<performance_traces_vector_element_type> performance_traces_vector(5);
    performance_traces_mutable_buffer_type performance_traces_buffer_{0};
    // Expected data
    std::vector<adas::perception::PerformanceTrace> performance_traces_vector_expected(5);

    score::log::LoggerConsoleSink console_logger_output_{score::log::LogLevel::kDebug3};
};

#endif  // PERFORMANCETRACERUNITTEST_HPP
