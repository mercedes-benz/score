void PerformanceTracerTest::ValidateOutputData() {
    ASSERT_EQ(performance_traces_vector_expected.size(), performance_traces_vector.size());
    for (size_t idx = 0; idx < performance_traces_vector.size(); idx++) {
        performance_traces_vector_element_type& pair_output = *performance_traces_vector[idx];
        score::comm::SampleBufferEntry<adas::perception::PerformanceTrace, score::comm::kDefaultPageSize>& output_buff = *pair_output.second;
        const adas::perception::PerformanceTrace& runnable_result = output_buff.sample.get();
        const adas::perception::PerformanceTrace& expected_result = *performance_traces_vector_expected[idx];
        ASSERT_TRUE( std::memcmp( &runnable_result, &expected_result, sizeof(adas::perception::PerformanceTrace) ) == 0 );
    }
}

