void PerformanceTracerTest::InitOutputBuffers() {
    std::error result{std::errorCode::kSuccess};
    ///////////////////////////////////////////////////////
    // performance_traces containers for the output processing for-loops
    score::comm::TopicId performance_traces_topic_id_{};
    // Trying to emulate what Fabric does for the SHM buffer
    score::comm::TopicName output_topic_name_performance_traces =
        score::comm::TopicName::fromStrings("test", "test", "test", "PerformanceTrace_out").value_or({});

    // Initialize performance_traces output buffers
    result = buffer_manager_.initialize<adas::perception::PerformanceTrace, 2>(output_topic_name_performance_traces);
    if (!result.success()) {
        score::log::fatal(kLogPrefix, "Failed to initialize buffer manager for output");
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    result = performance_traces_buffer_.open(output_topic_name_performance_traces.fullName());
    if (!result.success()) {
        score::log::fatal(kLogPrefix, "Failed to open ShmBuffer: ", result);
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    result = performance_traces_buffer_.reclaim();
    if (!result.success()) {
        score::log::warn(kLogPrefix, "Failed to reclaim samples..", result);
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    output_buffers_.reset( new PerformanceTracerOutputs {
        std::queue<performance_traces_mutable_buffer_type::base_type, 5>  {
            performance_traces_buffer_,
            performance_traces_vector
        },
    });
}

