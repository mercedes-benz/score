void NeuralNetInferenceTest::ValidateOutputData() {
    ASSERT_EQ(detections_vector_expected.size(), detections_vector.size());
    for (size_t idx = 0; idx < detections_vector.size(); idx++) {
        detections_vector_element_type& pair_output = *detections_vector[idx];
        score::comm::SampleBufferEntry<adas::perception::ObjectDetections, score::comm::kDefaultPageSize>& output_buff = *pair_output.second;
        const adas::perception::ObjectDetections& runnable_result = output_buff.sample.get();
        const adas::perception::ObjectDetections& expected_result = *detections_vector_expected[idx];
        ASSERT_TRUE( std::memcmp( &runnable_result, &expected_result, sizeof(adas::perception::ObjectDetections) ) == 0 );
    }
}

void NeuralNetInferenceTest::InitInputBuffers() {
    std::error result{std::errorCode::kSuccess};
    // adas::perception::CameraFrame
    score::comm::TopicName input_topic_name_input_frames = score::comm::TopicName::fromStrings("test", "test", "test", "input_frames_in").value_or({});
    result = buffer_manager_.initialize<adas::perception::CameraFrame, 3>(input_topic_name_input_frames);
    if (!result.success()) {
