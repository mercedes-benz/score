    }
    ASSERT_EQ(result, std::errorCode::kSuccess);

    input_frames_received_.push_back(&test_input_frames_);
    input_buffers_.reset( new NeuralNetInferenceInputs{
      std::queue{ input_frames_received_ },
    });
}

void NeuralNetInferenceTest::InitOutputBuffers() {
    std::error result{std::errorCode::kSuccess};
    ///////////////////////////////////////////////////////
    // detections containers for the output processing for-loops
    score::comm::TopicId detections_topic_id_{};
    // Trying to emulate what Fabric does for the SHM buffer
    score::comm::TopicName output_topic_name_detections =
        score::comm::TopicName::fromStrings("test", "test", "test", "ObjectDetections_out").value_or({});

    // Initialize detections output buffers
    result = buffer_manager_.initialize<adas::perception::ObjectDetections, 2>(output_topic_name_detections);
    if (!result.success()) {
        score::log::fatal(kLogPrefix, "Failed to initialize buffer manager for output");
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    result = detections_buffer_.open(output_topic_name_detections.fullName());
    if (!result.success()) {
        score::log::fatal(kLogPrefix, "Failed to open ShmBuffer: ", result);
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    result = detections_buffer_.reclaim();
    if (!result.success()) {
        score::log::warn(kLogPrefix, "Failed to reclaim samples..", result);
    }
    ASSERT_EQ(result, std::errorCode::kSuccess);
    output_buffers_.reset( new NeuralNetInferenceOutputs {
        std::queue<detections_mutable_buffer_type::base_type, 1>  {
            detections_buffer_,
            detections_vector
        },
    });
}

