#ifndef NEURALNETINFERENCEUNITTEST_HPP
#define NEURALNETINFERENCEUNITTEST_HPP

#include "runnable.hpp"

#include <atomic>
#include <csignal>
#include <cstdint>
#include <memory>

#include <system_error>
#include <cstdint>
#include <score/log/LoggerConsoleSink.hpp>
#include <score/middleware/Port.hpp>
#include <score/middleware/TaskBase.hpp>
#include <score/middleware/Util.hpp>

#include <gtest/gtest.h>

class NeuralNetInferenceTest : public ::testing::Test {
  protected:
    void SetUp() override;
    void TearDown() override;
    void SetInputData();
    void SetParameters();
    void SetExpectedOutputData();
    void InitInputBuffers();
    void InitOutputBuffers();
    void ValidateOutputData();
    void OnInit();
    void OnUpdate();
    void OnReset();

  private:
    static constexpr std::string_view kLogPrefix{"NeuralNetInferenceTest"};

    using detections_mutable_buffer_type = score::comm::ShmMutableSampleBuffer<adas::perception::ObjectDetections, 4>;
    using detections_vector_element_type = std::pair<score::comm::SampleReference::slot_type, detections_mutable_buffer_type::mutable_sample_type>;

    // Inputs
    adas::perception::CameraFrame test_input_frames_{};

    NeuralNetInferenceParameters parameters_{};

    NeuralNetInference runnable_{};
    score::comm::ShmSampleBufferManager<> buffer_manager_{};
    NeuralNetInferenceInternalState internal_state_{};

    // Input buffers
    std::unique_ptr<NeuralNetInferenceInputs> input_buffers_{};
    std::vector<const adas::perception::CameraFrame*> input_frames_received_(1);

    // Output buffers
    std::unique_ptr<NeuralNetInferenceOutputs> output_buffers_{};

    // adas::perception::ObjectDetections containers
    std::vector<detections_vector_element_type> detections_vector(1);
    detections_mutable_buffer_type detections_buffer_{0};
    // Expected data
    std::vector<adas::perception::ObjectDetections> detections_vector_expected(1);

    score::log::LoggerConsoleSink console_logger_output_{score::log::LogLevel::kDebug3};
};

#endif  // NEURALNETINFERENCEUNITTEST_HPP
