#ifndef TRAFFICSIGNRECOGNITIONUNITTEST_HPP
#define TRAFFICSIGNRECOGNITIONUNITTEST_HPP

#include "runnable.hpp"

#include <atomic>
#include <csignal>
#include <cstdint>
#include <memory>

#include <system_error>
#include <cstdint>
#include <score/log/LoggerConsoleSink.hpp>
#include <score/middleware/Port.hpp>
#include <score/middleware/TaskBase.hpp>
#include <score/middleware/Util.hpp>

#include <gtest/gtest.h>

class TrafficSignRecognitionTest : public ::testing::Test {
  protected:
    void SetUp() override;
    void TearDown() override;
    void SetInputData();
    void SetParameters();
    void SetExpectedOutputData();
    void InitInputBuffers();
    void InitOutputBuffers();
    void ValidateOutputData();
    void OnInit();
    void OnUpdate();
    void OnReset();

  private:
    static constexpr std::string_view kLogPrefix{"TrafficSignRecognitionTest"};

    using traffic_sign_commands_mutable_buffer_type = score::comm::ShmMutableSampleBuffer<adas::perception::TrafficSignCommand, 2>;
    using traffic_sign_commands_vector_element_type = std::pair<score::comm::SampleReference::slot_type, traffic_sign_commands_mutable_buffer_type::mutable_sample_type>;

    // Inputs
    adas::perception::ObjectDetections test_object_detections_{};

    TrafficSignRecognitionParameters parameters_{};

    TrafficSignRecognition runnable_{};
    score::comm::ShmSampleBufferManager<> buffer_manager_{};
    TrafficSignRecognitionInternalState internal_state_{};

    // Input buffers
    std::unique_ptr<TrafficSignRecognitionInputs> input_buffers_{};
    std::vector<const adas::perception::ObjectDetections*> object_detections_received_(1);

    // Output buffers
    std::unique_ptr<TrafficSignRecognitionOutputs> output_buffers_{};

    // adas::perception::TrafficSignCommand containers
    std::vector<traffic_sign_commands_vector_element_type> traffic_sign_commands_vector(1);
    traffic_sign_commands_mutable_buffer_type traffic_sign_commands_buffer_{0};
    // Expected data
    std::vector<adas::perception::TrafficSignCommand> traffic_sign_commands_vector_expected(1);

    score::log::LoggerConsoleSink console_logger_output_{score::log::LogLevel::kDebug3};
};

#endif  // TRAFFICSIGNRECOGNITIONUNITTEST_HPP
