{% if has_parameters %}
#include "{{ runnable_snake_name }}_parameter.hpp"
{% endif %}
{% if has_internal_state %}
#include "{{ runnable_snake_name }}_internal_state.hpp"
{% endif %}
#include "{{ runnable_snake_name }}.hpp"

int main() {
{% if has_parameters %}
    const {{ parameters_struct_name }} params{};
{% endif %}
{% if has_internal_state %}
    {{ internal_state_struct_name }} state{};
{% endif %}
{% if has_inputs %}
    const {{ archetype_namespace }}::{{ runnable_snake_name }}::Inputs inputs{};
{% endif %}
{% if has_outputs %}
    {{ archetype_namespace }}::{{ runnable_snake_name }}::Outputs outputs{};
{% endif %}

    auto rc = {{ archetype_namespace }}::{{ runnable_snake_name }}::on_init({% if has_parameters %}params{% endif %}{% if has_parameters and has_internal_state %}, {% endif %}{% if has_internal_state %}state{% endif %});
    if (rc != score::base::ErrorCode::Success()) {
        return 1;
    }

    rc = {{ archetype_namespace }}::{{ runnable_snake_name }}::on_update({% if has_parameters %}params{% endif %}{% if has_parameters and has_inputs %}, {% endif %}{% if has_inputs %}inputs{% endif %}{% if (has_parameters or has_inputs) and has_outputs %}, {% endif %}{% if has_outputs %}outputs{% endif %}{% if (has_parameters or has_inputs or has_outputs) and has_internal_state %}, {% endif %}{% if has_internal_state %}state{% endif %});
    return rc == score::base::ErrorCode::Success() ? 0 : 1;
}
